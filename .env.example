DATABASE_URL="postgresql://tracewell:tracewell@localhost:5455/tracewell"
REDIS_URL="redis://localhost:6399"
# Salt used when hashing API key secrets. Generate your own for any non-local deployment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY_SALT="dev-only-salt-change-me"
# Session signing secret for dashboard auth (NextAuth). Generate your own for any
# non-local deployment: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="dev-only-auth-secret-change-me"

# Optional: who may open /admin/growth (comma separated), and Umami analytics for the public pages.
# Analytics is off unless both Umami values are set.
# SIGNUPS_DISABLED=true           # close registration (existing users still sign in)
# SITE_URL=https://spanrail.example.com   # public address; lets search engines index the landing page (unset: noindex)
# GOOGLE_SITE_VERIFICATION=   # Search Console HTML-tag token; used only when SITE_URL is set
# ADMIN_EMAILS=you@example.com
# UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
# UMAMI_WEBSITE_ID=
