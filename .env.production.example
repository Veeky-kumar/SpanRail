# Used only for the containerized deployment (docker-compose.prod.yml), passed via
# `--env-file .env.production`. DATABASE_URL and REDIS_URL are NOT read from here —
# the web/worker containers reach Postgres/Redis by their Docker service names
# (postgres:5432, redis:6379), fixed directly in docker-compose.prod.yml.
#
# Generate real values for anything beyond a local trial:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY_SALT="change-me-generate-a-real-value"
AUTH_SECRET="change-me-generate-a-real-value"
