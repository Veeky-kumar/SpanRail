# Copy to .env (deploy/install.sh does this for you and generates the secrets).
# Generate each secret with:  openssl rand -hex 32
POSTGRES_PASSWORD=
API_KEY_SALT=
AUTH_SECRET=

# Optional
# SPANRAIL_VERSION=0.1.0          # pin the web and worker images (default: latest)
# WEB_PORT=3000
# WEB_BIND=127.0.0.1              # 0.0.0.0 only behind a reverse proxy with TLS

# Gateway (docker compose --profile gateway up -d); create the key pair in the dashboard first
# UPSTREAM_URL=https://api.openai.com
# SPANRAIL_PUBLIC_KEY=
# SPANRAIL_SECRET_KEY=
